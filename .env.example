# ===== ISAIC — environment =====
# Copy to .env and fill in. The bot degrades gracefully: a missing model key
# just disables that one head. Only the two Slack tokens + >=1 model key are
# required to start.

# --- Slack (required) ---
# Create the app from slack-app-manifest.yaml at https://api.slack.com/apps,
# then enable Socket Mode. No public URL is needed.
# Bot User OAuth Token (OAuth & Permissions page) — starts xoxb-
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-Level Token with the connections:write scope (Basic Information page) — starts xapp-
SLACK_APP_TOKEN=xapp-your-app-token

# --- Models (each OPTIONAL; set the ones you want) ---
# Claude / Judah — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Gemini / Joseph — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Deepseek / Zebulun — https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# Fireworks (Qwen/Benjamin + GLM/Gad; optional Deepseek/Mistral backends) — https://fireworks.ai/
FIREWORKS_API_KEY=
# Mistral / Naphtali — https://console.mistral.ai/  (its own EU API)
MISTRAL_API_KEY=
# Together AI — only for providers.mistral.backend = "together" — https://api.together.xyz/
TOGETHER_API_KEY=

# --- Features (OPTIONAL) ---
# Tavily web search (for heads without native search) — https://tavily.com/
TAVILY_API_KEY=
# Azure Speech — enables !speak (Mandarin) + !french TTS. Create a "Speech service"
# resource, copy Key 1 + the region (e.g. eastus).
AZURE_TTS_KEY=
AZURE_TTS_REGION=
# AO3 session cookie (_otwarchive_session) for bookclub when AO3 is shields-up.
AO3_COOKIE=

# --- Tuning knobs (OPTIONAL) ---
GEMINI_CACHE_TTL_HOURS=6
GRID_GCO2_PER_KWH=400
MODEL_LIFETIME_TOKENS=1e14
AMORTIZE_TRAINING=1

# --- Gemini Vertex backend (OPTIONAL; only if providers.gemini.backend=="vertex") ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
